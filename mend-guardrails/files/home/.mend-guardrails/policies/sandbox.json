{
  "version": 1,
  "pre_flight": {
    "version": 1,
    "guardrails": [
      {
        "name": "PII",
        "suppress_enforcement": true,
        "config": {
          "entities": ["EMAIL_ADDRESS", "PHONE_NUMBER", "US_SSN", "CREDIT_CARD"],
          "block": false,
          "detect_encoded_pii": true
        }
      }
    ]
  },
  "input": {
    "version": 1,
    "guardrails": [
      {
        "name": "Secret Keys",
        "suppress_enforcement": false,
        "config": {
          "threshold": "balanced"
        }
      },
      {
        "name": "PromptInjection",
        "suppress_enforcement": false,
        "config": {
          "confidence_threshold": 0.6
        }
      }
    ]
  },
  "output": {
    "version": 1,
    "guardrails": [
      {
        "name": "Secret Keys",
        "suppress_enforcement": false,
        "config": {
          "threshold": "balanced"
        }
      },
      {
        "name": "PII",
        "suppress_enforcement": false,
        "config": {
          "entities": ["EMAIL_ADDRESS", "PHONE_NUMBER", "US_SSN", "CREDIT_CARD"],
          "block": true
        }
      }
    ]
  }
}
